# ========================================================
# ShopSphere Environment Configuration Template
# Copy to .env and adjust variables as needed
# ========================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database URLs (Microservices)
AUTH_DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/shopsphere_auth
PRODUCT_DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/shopsphere_products
ORDER_DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/shopsphere_orders
INVENTORY_DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/shopsphere_inventory

# JWT Shared Secret Key (at least 256 bits for HMAC-SHA256)
JWT_SECRET=MyVerySecretKeyForShopSphereApplicationThatIsAtLeast256BitsLong123456
JWT_EXPIRATION_MS=86400000

# Service URLs (for Gateway and Inter-Service Routing)
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:5173
